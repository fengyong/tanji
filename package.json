{
  "name": "tanji-native",
  "version": "0.1.0",
  "description": "探记 TanJi iOS App —— Capacitor 壳复用 Web UI,SQLite 本机存储",
  "private": true,
  "scripts": {
    "build:plugins": "esbuild src/cap-plugins.js --bundle --format=iife --outfile=www/cap-plugins.js --minify",
    "sync": "npm run build:plugins && cap sync ios",
    "open:ios": "cap open ios",
    "serve": "python3 -m http.server 8765 --directory www"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.28.2"
  }
}
