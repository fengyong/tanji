{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@tanji/*": ["../../packages/*/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "workers/**/*.ts", "vite.config.ts"]
}
